# Crier configuration
# Copy to .env and fill in your values.

# Repos to watch. Empty uses the announcement allowlist:
# OpenAdaptAI/OpenAdapt, OpenAdaptAI/openadapt-flow, OpenAdaptAI/openadapt-blog
# CRIER_REPOS=OpenAdaptAI/OpenAdapt,OpenAdaptAI/openadapt-flow,OpenAdaptAI/openadapt-blog

# Optional overrides for what scores 9
# CRIER_ALLOWLIST_RELEASE_REPOS=OpenAdaptAI/OpenAdapt,OpenAdaptAI/openadapt-flow
# CRIER_ALLOWLIST_BLOG_REPOS=OpenAdaptAI/openadapt-blog

# GitHub token (higher API rate limits). Falls back to GH_TOKEN.
CRIER_GITHUB_TOKEN=ghp_...

# Poll interval in seconds (default: 60)
CRIER_POLL_INTERVAL=60

# Interestingness threshold (0-10, default: 5). Allowlisted events score 9.
CRIER_INTEREST_THRESHOLD=5

# Telegram is optional. Drafts still write to sqlite without these.
# CRIER_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# CRIER_TELEGRAM_OWNER_ID=123456789

# Claude drafts are off by default. Templates do not need a key.
# CRIER_USE_CLAUDE=false
# CRIER_ANTHROPIC_API_KEY=sk-ant-...

# Herald credentials are required only to auto-post after approval.
# CRIER_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# CRIER_TWITTER_CONSUMER_KEY=...
# CRIER_TWITTER_CONSUMER_SECRET=...
# CRIER_TWITTER_ACCESS_TOKEN=...
# CRIER_TWITTER_ACCESS_TOKEN_SECRET=...
# CRIER_LINKEDIN_ACCESS_TOKEN=...

# Database path (default: ./crier.db)
CRIER_DB_PATH=./crier.db

# Dry run mode — preview without posting (default: false)
CRIER_DRY_RUN=false
